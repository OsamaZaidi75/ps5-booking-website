# ── Supabase (Postgres) ──────────────────────────────────────────────
# Project Settings → API. Use the SERVICE ROLE key only in serverless
# functions (never expose it to the frontend/browser).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (email) ───────────────────────────────────────────────────
# https://resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender address/domain in Resend (or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=PS5 Arena <bookings@yourdomain.com>
# Your personal inbox — every booking gets emailed here
OWNER_EMAIL=you@example.com

# ── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────
# https://dash.cloudflare.com/ → Turnstile → Add site (free)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Public site key, safe to expose to the frontend — set as VITE_ var too
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ── Security ──────────────────────────────────────────────────────────
# Any long random string. Used to sign expiring customer cancel links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CANCEL_LINK_SECRET=replace-with-a-long-random-string

# Admin password for /admin (single shared password, constant-time compared)
ADMIN_PASSWORD=choose-a-strong-password
# Secret used to sign the admin session cookie (separate from CANCEL_LINK_SECRET)
ADMIN_SESSION_SECRET=replace-with-another-long-random-string

# Exact origin allowed to call the API (no trailing slash). Also used for
# building cancel links. In local dev this is http://localhost:3000
PUBLIC_SITE_URL=https://your-site.vercel.app

# ── Business rules (all optional, sensible defaults applied) ────────
# 24h "HH:mm", IST assumed
BUSINESS_START_TIME=10:00
BUSINESS_END_TIME=22:00
# Minutes required between consecutive bookings. 0 disables the buffer.
BOOKING_BUFFER_MINUTES=15

# ── Future / not implemented (see api/_lib/sms.js) ───────────────────
# SMS_PROVIDER_API_KEY=
